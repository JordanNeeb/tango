# Copy to supabase/functions/.env for local development (git-ignored). Locally,
# leave RESEND_API_KEY empty so invite emails go to Mailpit. In staging and
# production, set these with `npx supabase@latest secrets set`.
SITE_URL=http://localhost:3000
INVITE_FROM_EMAIL=Tango <no-reply@tango.local>
RESEND_API_KEY=
MAILPIT_URL=http://supabase_inbucket_tango:8025
