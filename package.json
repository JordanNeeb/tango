{
  "name": "tango",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @tango/web",
    "build:web": "npm run build -w @tango/web",
    "lint:web": "npm run lint -w @tango/web",
    "start:mobile": "npm run start -w @tango/mobile",
    "ios": "npm run ios -w @tango/mobile",
    "android": "npm run android -w @tango/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
